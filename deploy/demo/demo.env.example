# Deployment placeholders only. Copy to deploy/demo/demo.env on the DEMO SERVER.
# Do not copy backend/.env or put real values in this committed template.
# Set the DNS A/AAAA records to the server, then use a bare domain for HTTPS.
# For a temporary IP test only, use http://YOUR_SERVER_IP (no automatic HTTPS).
DEMO_SITE_ADDRESS=demo.example.com
DEMO_CORS_ORIGINS=https://demo.example.com

# Generate independent random hexadecimal values (avoids URL escaping mistakes).
# MYSQL_USER is campus_demo and MYSQL_DATABASE is campus_demo, host MUST be db.
DEMO_DB_PASSWORD=
DEMO_DB_ROOT_PASSWORD=
DATABASE_URL=mysql+pymysql://campus_demo:REPLACE_WITH_DEMO_DB_PASSWORD@db:3306/campus_demo
JWT_SECRET_KEY=

# These never change the passwords/accounts in the local project database.
# Keep the administrator password private. The student password may be published.
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=

# Empty provider keys deliberately disable AI; the business pages still work.
# Only fill separate demo provider keys when explicitly enabling real paid AI.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# Explicit opt-in: process ONLY newly authored fictional sample docs at seed time.
DEMO_INDEX_DOCUMENTS=false

# Cost and resource limits for public demonstrations, applied by the wrapper.
# Counters survive API restarts in its private demo_state volume.
DEMO_AI_PER_MINUTE=3
DEMO_AI_PER_USER_DAY=20
DEMO_AI_GLOBAL_DAY=60
DEMO_AI_CONCURRENCY=2
DEMO_AI_TIMEOUT_SECONDS=90
DEMO_MAX_OUTPUT_TOKENS=700
