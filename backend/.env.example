DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/backend
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# Fill the real DeepSeek key in your local .env only; never commit it.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=6

# Fill only your local .env; never commit an embedding key or source documents.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# Empty means backend/chroma_data. Relative paths resolve against backend.
CHROMA_DIR=
# Candidate pool: 6–8; final results remain at most 3 and distance <= 0.40.
# 0.40 is calibrated for the current embedding model and document set:
# worst answer-block distance 0.3883 < 0.40 < nearest unrelated distance 0.4162.
# Recalibrate (tests/manual/rag_quality_diagnose.py) if either changes.
RAG_CANDIDATE_COUNT=8

# Week 1 starts on this Monday; no local .env changes are required for defaults.
SEMESTER_START_DATE=2026-09-07
TOTAL_WEEKS=20

# Browser origins allowed to call this API (comma separated).
# Change this instead of editing app/main.py when deploying elsewhere.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
